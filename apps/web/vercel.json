{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "/api?__athleteos_path=/api/v1"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api?__athleteos_path=/api/v1/:path*"
    }
  ]
}
