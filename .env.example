# Runtime
APP_ENV=development
APP_NAME=AthleteOS API
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000

# PostgreSQL is the production system of record. The API also supports SQLite for
# a zero-dependency local smoke run and isolated unit tests.
DATABASE_URL=postgresql+psycopg://athleteos:athleteos@postgres:5432/athleteos

# Turso alternative. When TURSO_DATABASE_URL is set it takes precedence over
# DATABASE_URL. Keep the auth token in local/deployment secrets, never in Git.
TURSO_DATABASE_URL=libsql://gym-prathamverma24.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=
REDIS_URL=redis://redis:6379/0

# Replace in every non-local environment.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Vercel: leave NEXT_PUBLIC_API_URL unset to use the same-origin Python API.
# Attach Turso through TURSO_DATABASE_URL + TURSO_AUTH_TOKEN, or managed Postgres
# through DATABASE_URL/POSTGRES_URL. SQLite under /tmp is only an ephemeral
# smoke-test fallback when no managed database is set.
AUTO_CREATE_DB=true

# Optional private S3-compatible media storage. Raw scan storage is disabled
# unless a user separately consents and these values are configured.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

SENTRY_DSN=
